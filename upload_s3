#!/usr/bin/env bash
set -euo pipefail

: "${AWS_DISTRIBUTION_ID:?AWS_DISTRIBUTION_ID must be set}"

echo "# Uploading to s3..."

for font in Subset/AlphaSans*
do
  aws s3 cp "$font" "s3://alphaprime-storage/file/AlphaSans/"
done
aws s3 cp "./css/alpha-sans.css" "s3://alphaprime-storage/file/AlphaSans/alpha-sans.css"

aws cloudfront create-invalidation --distribution-id "$AWS_DISTRIBUTION_ID" --paths '/AlphaSans*'
